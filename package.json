{
  "name": "knip-example",
  "packageManager": "yarn@4.5.3",
  "type": "module",
  "scripts": {
    "knip": "knip",
    "start": "tsx --require pretty-error/start src/main.ts",
    "qa": "yarn format:check && yarn lint && yarn typecheck && yarn test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "dayjs": "1.11.13",
    "pretty-error": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@tsconfig/node22": "22.0.0",
    "@types/node": "22.10.1",
    "eslint": "9.16.0",
    "globals": "15.13.0",
    "knip": "5.39.1",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.17.0",
    "vitest": "2.1.8"
  }
}
