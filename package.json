{
  "name": "knip-example",
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "scripts": {
    "knip": "knip",
    "start": "tsx src/main.ts",
    "start:pretty": "ts-node --require pretty-error/start src/main.ts",
    "qa": "yarn format:check && yarn lint && yarn typecheck && yarn test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dayjs": "1.11.13",
    "moment": "2.30.1",
    "pretty-error": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@tsconfig/node22": "22.0.0",
    "@types/node": "24.0.4",
    "@vitest/coverage-istanbul": "2.1.8",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.16.0",
    "globals": "15.13.0",
    "knip": "5.61.2",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.36.0",
    "vitest": "2.1.8",
    "webpack": "5.99.9",
    "yargs": "18.0.0"
  }
}
